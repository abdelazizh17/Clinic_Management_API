# Copy this file to ".env" and change every value.
# ".env" is ignored by Git and must never be committed.

# SQL Server "sa" password. Must be strong (upper, lower, digit, symbol).
SQL_SA_PASSWORD=ChangeMe_Str0ng!Pass

# JWT signing key. Minimum 32 characters.
JWT_KEY=ChangeMe_At_Least_32_Characters_Long_Secret

# The admin user that is created automatically on first startup.
SEED_ADMIN_EMAIL=admin@clinic.com
SEED_ADMIN_USERNAME=AdminMaster
SEED_ADMIN_PASSWORD=ChangeMe_Admin@12345
